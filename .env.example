# Copier ce fichier en ".env" (non versionné) et renseigner les valeurs.

# Console Firebase > Paramètres du projet > Vos applications
VITE_FIREBASE_API_KEY=

# Compte EmailJS (https://www.emailjs.com) : Service, Template et clé
# publique utilisés pour prévenir un contact que ses informations sont
# visibles sur le site, avec un lien pour les masquer.
# Variables attendues par le template EmailJS : to_email, to_name,
# company_name, contact_role, hide_url.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
