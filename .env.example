# Copier ce fichier en ".env" (non versionné) et renseigner les valeurs.

# Console Firebase > Paramètres du projet > Vos applications
VITE_FIREBASE_API_KEY=

# Compte EmailJS (https://www.emailjs.com) : Service, Templates et clé
# publique. Deux templates distincts sur le même service :
# - VITE_EMAILJS_TEMPLATE_ID : prévient un contact que ses informations sont
#   visibles sur le site, avec un lien pour les masquer.
#   Variables attendues : to_email, to_name, company_name, contact_role,
#   hide_url.
# - VITE_EMAILJS_VERIFY_TEMPLATE_ID : confirme l'adresse email d'un compte
#   étudiant à l'inscription (remplace le sendEmailVerification natif de
#   Firebase, qui nécessite le forfait Blaze pour être personnalisé).
#   Variables attendues : to_email, verify_url.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_VERIFY_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
