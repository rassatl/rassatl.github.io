rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deux types de comptes Firebase Auth coexistent : les administrateurs
    // (email + mot de passe) et les étudiants, qui créent eux-mêmes leur
    // compte (email + mot de passe) puis doivent le vérifier. Être
    // authentifié ne suffit donc pas à être admin : il faut avoir un
    // document admins/{uid}, créé à la main depuis la console Firebase
    // (aucun client ne peut l'écrire).
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Étudiant dont l'email a été confirmé via le lien de vérification envoyé
    // par EmailJS à l'inscription (voir studentAccounts et
    // emailVerificationTokens ci-dessous ; pas de Cloud Function, donc pas le
    // sendEmailVerification / email_verified natif de Firebase Auth). Le
    // domaine doit rester synchronisé avec src/utils/studentEmail.js.
    function isStudent() {
      return request.auth != null
        && request.auth.token.email.lower().matches('.+@groupe-esigelec[.]org')
        && get(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)).data.emailVerified == true
        && get(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)).data.email == request.auth.token.email;
    }

    function companyKeys() {
      return [
        'speciality', 'name', 'address', 'city', 'country', 'pc', 'x', 'y', 'mission', 'review', 'website'
      ];
    }

    // Une entreprise ajoutée de façon confidentielle : réservée aux visiteurs
    // non connectés (voir la règle create de pendingCompanies), sans aucune
    // information identifiante (pas de nom, pas d'adresse précise).
    function confidentialCompanyKeys() {
      return ['speciality', 'city', 'country', 'x', 'y', 'review'];
    }

    // Une entreprise publiée est lisible par tout le monde : elle n'embarque
    // l'email de l'étudiant qui l'a proposée (addedBy) que si celui-ci a
    // choisi de s'afficher. Dans tous les cas, l'auteur est conservé à part,
    // dans la collection privée companyAuthors. Deux formats possibles : le
    // format complet (admin ou étudiant connecté) ou le format confidentiel
    // (visiteur non connecté, voir isValidPendingCompanyData).
    function isValidCompanyData(data) {
      return (
        (data.keys().hasOnly(companyKeys().concat(['addedBy'])) && hasValidCompanyFields(data))
        || (data.keys().hasOnly(confidentialCompanyKeys()) && hasValidConfidentialCompanyFields(data))
      ) && (!('addedBy' in data) || (data.addedBy is string && data.addedBy.size() > 0 && data.addedBy.size() <= 200));
    }

    // Une proposition en attente porte l'email étudiant vérifié de son auteur
    // (lisible uniquement par un admin, voir plus bas) et son choix de
    // s'afficher ou non une fois l'entreprise publiée — uniquement pour le
    // format complet (admin ou étudiant connecté) : le format confidentiel
    // est toujours anonyme, ces deux champs n'y ont pas leur place.
    function isValidPendingCompanyData(data) {
      return (
        (data.keys().hasOnly(companyKeys().concat(['submittedBy', 'submitterVisible'])) && hasValidCompanyFields(data)
          && (!('submittedBy' in data) || (data.submittedBy is string && data.submittedBy.size() <= 200))
          && (!('submitterVisible' in data) || data.submitterVisible is bool))
        || (data.keys().hasOnly(confidentialCompanyKeys()) && hasValidConfidentialCompanyFields(data))
      );
    }

    // Trace privée de l'auteur d'une entreprise publiée.
    function isValidCompanyAuthorData(data) {
      return data.keys().hasOnly(['submittedBy', 'visible', 'companyName', 'approvedAt'])
        && data.submittedBy is string && data.submittedBy.size() > 0 && data.submittedBy.size() <= 200
        && data.visible is bool
        && data.companyName is string && data.companyName.size() > 0 && data.companyName.size() <= 120
        && data.approvedAt is timestamp;
    }

    function hasValidCompanyFields(data) {
      return data.speciality in [
        'Développement Logiciel, Tests et Qualité', 'IA & Big Data'
      ]
      && data.name is string
      && data.name.size() > 0
      && data.name.size() <= 120
      && data.address is string
      && data.address.size() > 0
      && data.address.size() <= 200
      && data.city is string
      && data.city.size() > 0
      && data.city.size() <= 100
      && data.country is string
      && data.country.size() > 0
      && data.country.size() <= 100
      && data.pc is string
      && data.pc.size() > 0
      && data.pc.size() <= 20
      && data.x is number
      && data.x >= -90
      && data.x <= 90
      && data.y is number
      && data.y >= -180
      && data.y <= 180
      && data.mission is string
      && data.mission.size() > 0
      && data.mission.size() <= 1000
      && (!('review' in data) || isValidReview(data.review))
      && (!('website' in data) || (data.website is string && data.website.size() <= 300));
    }

    function isValidReview(review) {
      return review.keys().hasOnly(['rating', 'comment'])
        && review.rating is int
        && review.rating >= 1
        && review.rating <= 5
        && (!('comment' in review) || (review.comment is string && review.comment.size() <= 500));
    }

    function hasValidConfidentialCompanyFields(data) {
      return data.speciality in [
        'Développement Logiciel, Tests et Qualité', 'IA & Big Data'
      ]
      && data.city is string
      && data.city.size() > 0
      && data.city.size() <= 100
      && data.country is string
      && data.country.size() > 0
      && data.country.size() <= 100
      && data.x is number
      && data.x >= -90
      && data.x <= 90
      && data.y is number
      && data.y >= -180
      && data.y <= 180
      && (!('review' in data) || isValidConfidentialReview(data.review));
    }

    // Avis personnel, facultatif, sur le ressenti de l'étudiant (mission,
    // pays, logement...), sans lien avec l'identité de l'entreprise.
    function isValidConfidentialReview(review) {
      return review.keys().hasOnly(['rating', 'missionFeeling', 'countryFeeling', 'housingFeeling'])
        && (!('rating' in review) || (review.rating is int && review.rating >= 1 && review.rating <= 5))
        && (!('missionFeeling' in review) || (review.missionFeeling is string && review.missionFeeling.size() <= 500))
        && (!('countryFeeling' in review) || (review.countryFeeling is string && review.countryFeeling.size() <= 500))
        && (!('housingFeeling' in review) || (review.housingFeeling is string && review.housingFeeling.size() <= 500));
    }

    // Moyen de contact du formulaire confidentiel : au choix de l'étudiant qui
    // dépose le point (email perso, email étudiant, WhatsApp, LinkedIn), pour
    // qu'un autre étudiant intéressé puisse le joindre directement. Rien
    // n'est vérifié (ni format, ni identité) : tous les champs sont
    // facultatifs, mais au moins un doit être renseigné, sinon le point ne
    // serait pas contactable.
    function isValidConfidentialContactData(data) {
      return data.keys().hasOnly(['personalEmail', 'schoolEmail', 'whatsapp', 'linkedin'])
        && data.keys().size() > 0
        && (!('personalEmail' in data) || (data.personalEmail is string && data.personalEmail.size() > 0 && data.personalEmail.size() <= 200))
        && (!('schoolEmail' in data) || (data.schoolEmail is string && data.schoolEmail.size() > 0 && data.schoolEmail.size() <= 200))
        && (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() > 0 && data.whatsapp.size() <= 50))
        && (!('linkedin' in data) || (data.linkedin is string && data.linkedin.size() > 0 && data.linkedin.size() <= 300));
    }

    // Contact soumis via une proposition en attente : pas encore publié, pas
    // encore de jeton de masquage (celui-ci n'est créé qu'à la publication,
    // juste avant l'envoi de l'email). Réservé au format complet : une
    // proposition confidentielle n'a pas de contacts.
    function isValidPendingContactData(data) {
      return data.keys().hasOnly(['firstName', 'lastName', 'role', 'email', 'phone'])
        && data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 100
        && data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 100
        && data.role is string && data.role.size() > 0 && data.role.size() <= 150
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.phone is string && data.phone.size() <= 30;
    }

    // Contact d'une entreprise publiée : visible publiquement, et muni d'un
    // jeton permettant à la personne elle-même de masquer ses informations
    // sans être authentifiée (lien envoyé par email).
    function isValidPublishedContactData(data) {
      return data.keys().hasOnly(['firstName', 'lastName', 'role', 'email', 'phone', 'hidden', 'hideToken'])
        && data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 100
        && data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 100
        && data.role is string && data.role.size() > 0 && data.role.size() <= 150
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.phone is string && data.phone.size() <= 30
        && data.hidden is bool
        && data.hideToken is string && data.hideToken.size() >= 16;
    }

    // Un contact masqué par son propre titulaire : toutes les informations
    // personnelles sont effacées (pas seulement cachées côté affichage), le
    // jeton reste inchangé (il a servi à autoriser cette seule action).
    function isSelfRedactedContact(newData, oldData) {
      return newData.keys().hasOnly(['firstName', 'lastName', 'role', 'email', 'phone', 'hidden', 'hideToken'])
        && newData.firstName == ''
        && newData.lastName == ''
        && newData.role == ''
        && newData.email == ''
        && newData.phone == ''
        && newData.hidden == true
        && newData.hideToken == oldData.hideToken
        && oldData.hidden == false;
    }

    // Comptes administrateurs : le document admins/{uid} est créé à la main
    // depuis la console Firebase. Un utilisateur peut seulement vérifier s'il
    // a le sien (c'est ainsi que l'app sait afficher les actions admin) ;
    // personne ne peut lister ni écrire, sinon un étudiant pourrait se
    // promouvoir lui-même.
    match /admins/{adminUid} {
      allow get: if request.auth != null && request.auth.uid == adminUid;
      allow list, write: if false;
    }

    // Statut de vérification email d'un compte étudiant (voir isStudent()).
    // Lisible par tout le monde comme les contacts (l'identifiant, un uid
    // Firebase, n'est ni deviné ni listé, et n'expose qu'un email déjà fourni
    // par son propriétaire) : la page de vérification (VerifyAccountInfo,
    // sans connexion) doit pouvoir distinguer "déjà vérifié" d'un lien
    // invalide. La création n'est possible qu'à l'inscription, par le
    // titulaire du compte. Le passage à true ne peut se faire qu'une fois,
    // et seulement en prouvant la connaissance du jeton secret associé (voir
    // emailVerificationTokens) : pas besoin d'être connecté à ce moment-là,
    // exactement comme hideToken pour les contacts.
    match /studentAccounts/{uid} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'emailVerified'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailVerified == false;
      allow update: if resource.data.emailVerified == false
        && request.resource.data.keys().hasOnly(['email', 'emailVerified'])
        && request.resource.data.email == resource.data.email
        && request.resource.data.emailVerified == true
        && get(/databases/$(database)/documents/emailVerificationTokens/$(uid)).data.verified == true;
      allow delete: if false;
    }

    // Jeton secret de vérification email, envoyé par EmailJS dans le lien
    // ?verifyAccount=<uid>:<token> (voir useEmailNotifications.js et
    // VerifyAccountInfo.vue). Jamais lisible, même par le titulaire : seule
    // la connaissance du jeton (reçu par email) prouve qu'on est le
    // destinataire, pas une lecture Firestore. Deux écritures possibles une
    // fois le jeton créé : le renvoyer (nouveau jeton, réservé au titulaire
    // connecté, tant que non vérifié) ou le confirmer (n'importe qui muni du
    // bon jeton, une seule fois).
    match /emailVerificationTokens/{uid} {
      allow get, list: if false;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token', 'email', 'verified', 'createdAt'])
        && request.resource.data.token is string && request.resource.data.token.size() >= 24
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.verified == false
        && request.resource.data.createdAt is timestamp;
      allow update: if resource.data.verified == false
        && (
          (request.auth != null && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['token', 'email', 'verified', 'createdAt'])
            && request.resource.data.token is string && request.resource.data.token.size() >= 24
            && request.resource.data.email == resource.data.email
            && request.resource.data.verified == false
            && request.resource.data.createdAt is timestamp)
          || (request.resource.data.keys().hasOnly(['token', 'email', 'verified', 'createdAt', 'guess'])
            && request.resource.data.token == resource.data.token
            && request.resource.data.email == resource.data.email
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.verified == true
            && request.resource.data.guess == resource.data.token)
        );
      allow delete: if false;
    }

    // Qui a ajouté chaque entreprise publiée (email étudiant vérifié, et s'il
    // a choisi de s'afficher publiquement), indexé par l'identifiant de
    // l'entreprise. Collection privée : réservée aux admins, en lecture comme
    // en écriture, et conservée même quand la proposition en attente est
    // supprimée à la validation. N'existe que pour une entreprise du format
    // complet : une proposition confidentielle n'a jamais d'auteur.
    match /companyAuthors/{companyId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidCompanyAuthorData(request.resource.data);
      allow update, delete: if false;
    }

    // Entreprises validées, visibles publiquement sur la carte. Elles ne
    // peuvent être créées que par un administrateur connecté : soit
    // directement, soit via la validation d'une proposition en attente.
    match /companies/{companyId} {
      allow read: if true;
      allow create: if isAdmin() && isValidCompanyData(request.resource.data);
      allow update, delete: if false;

      // Personnes à contacter pour cette entreprise (CV / lettre de
      // motivation). Seuls les étudiants vérifiés (et les admins) peuvent les
      // lister : un visiteur ne peut donc pas récupérer les coordonnées.
      // La lecture d'un contact précis, par son identifiant, reste ouverte :
      // le lien « masquer mes informations » envoyé à la personne concernée
      // doit fonctionner sans connexion. Cet identifiant, aléatoire, n'est
      // connu que de la personne (dans son lien) et de ceux qui ont accès à
      // la liste. N'existe que pour une entreprise du format complet.
      match /contacts/{contactId} {
        allow get: if true;
        allow list: if isStudent() || isAdmin();
        allow create: if isAdmin() && isValidPublishedContactData(request.resource.data) && request.resource.data.hidden == false;
        allow delete: if false;
        allow update: if (isAdmin() && isValidPublishedContactData(request.resource.data))
          || isSelfRedactedContact(request.resource.data, resource.data);
      }

      // Moyen de contact du formulaire confidentiel (un seul document).
      // Mêmes droits de lecture que les contacts du format complet, mais pas
      // de lecture publique par identifiant : rien ici ne sert de lien
      // "masquer mes informations" à quiconque.
      match /confidentialContact/{contactId} {
        allow get: if false;
        allow list: if isStudent() || isAdmin();
        allow create: if isAdmin() && isValidConfidentialContactData(request.resource.data);
        allow update, delete: if false;
      }
    }

    // Propositions d'ajout. Deux formats possibles :
    // - le format complet (nom, adresse, site, mission...), attribué à un
    //   étudiant vérifié connecté, qui doit alors porter son propre email
    //   (submittedBy) et un choix de visibilité explicite ;
    // - le format confidentiel (spécialité, pays, ville seulement) : toujours
    //   anonyme, jamais de submittedBy ni de submitterVisible, quel que soit
    //   l'état de connexion de qui le soumet — un visiteur non connecté n'a
    //   que ce choix, mais un étudiant vérifié peut aussi le préférer au
    //   format complet (voir AddCompanyForm.vue).
    // Seul un administrateur connecté peut les lire, les modifier ou les
    // supprimer (refus, ou nettoyage après validation).
    match /pendingCompanies/{pendingId} {
      allow read: if isAdmin();
      allow create: if isValidPendingCompanyData(request.resource.data)
        && (
          (isStudent()
            && request.resource.data.submittedBy == request.auth.token.email
            && request.resource.data.submitterVisible is bool)
          || (!('submittedBy' in request.resource.data)
            && !('submitterVisible' in request.resource.data))
        );
      allow update: if isAdmin() && isValidPendingCompanyData(request.resource.data);
      allow delete: if isAdmin();

      // Un contact ne peut être ajouté que par l'auteur de la proposition
      // (format complet uniquement).
      match /contacts/{contactId} {
        allow read: if isAdmin();
        allow create: if isStudent()
          && isValidPendingContactData(request.resource.data)
          && get(/databases/$(database)/documents/pendingCompanies/$(pendingId)).data.submittedBy == request.auth.token.email;
        allow update: if isAdmin() && isValidPendingContactData(request.resource.data);
        allow delete: if isAdmin();
      }

      // Moyen de contact déposé avec une proposition confidentielle : ouvert
      // à l'ajout anonyme comme la proposition elle-même, réservé à un
      // pending du format confidentiel (repéré par l'absence du champ "name").
      match /confidentialContact/{contactId} {
        allow read: if isAdmin();
        allow create: if isValidConfidentialContactData(request.resource.data)
          && !('name' in get(/databases/$(database)/documents/pendingCompanies/$(pendingId)).data);
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    function isValidTicketData(data) {
      return data.keys().hasOnly(['title', 'description', 'status', 'createdAt', 'pageUrl', 'userAgent'])
        && data.title is string
        && data.title.size() <= 150
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 2000
        && data.status in ['open', 'in_progress', 'closed']
        && data.createdAt is timestamp
        && data.pageUrl is string
        && data.pageUrl.size() <= 500
        && data.userAgent is string
        && data.userAgent.size() <= 300;
    }

    // Signalements de problème envoyés depuis le bouton d'info, par
    // n'importe qui (y compris des visiteurs non connectés). Seul un
    // administrateur connecté peut les consulter ; la création impose un
    // statut initial "open" et la modification ne peut faire évoluer que ce
    // statut (titre/description/date figés une fois le ticket créé).
    match /tickets/{ticketId} {
      allow read: if isAdmin();
      allow create: if isValidTicketData(request.resource.data) && request.resource.data.status == 'open';
      allow update: if isAdmin()
        && isValidTicketData(request.resource.data)
        && request.resource.data.title == resource.data.title
        && request.resource.data.description == resource.data.description
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    function isValidErrorLogData(data) {
      return data.keys().hasOnly(['message', 'code', 'stack', 'context', 'createdAt', 'pageUrl', 'userAgent'])
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 500
        && (!('code' in data) || (data.code is string && data.code.size() <= 100))
        && data.stack is string
        && data.stack.size() <= 3000
        && data.context is string
        && data.context.size() <= 200
        && data.createdAt is timestamp
        && data.pageUrl is string
        && data.pageUrl.size() <= 500
        && data.userAgent is string
        && data.userAgent.size() <= 300;
    }

    // Erreurs techniques rencontrées par n'importe quel visiteur, journalées
    // automatiquement (pas de saisie utilisateur) pour pouvoir diagnostiquer
    // un problème en prod sans dépendre de la console de son navigateur.
    // Mêmes règles d'accès que les tickets : écriture publique, lecture et
    // suppression réservées à un administrateur connecté.
    match /errorLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isValidErrorLogData(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
