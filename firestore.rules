rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidCompanyData(data) {
      return data.keys().hasOnly([
        'speciality', 'name', 'address', 'city', 'country', 'pc', 'x', 'y', 'mission', 'review', 'website'
      ])
      && data.speciality in [
        'Développement Logiciel, Tests et Qualité', 'IA & Big Data'
      ]
      && data.name is string
      && data.name.size() > 0
      && data.name.size() <= 120
      && data.address is string
      && data.address.size() > 0
      && data.address.size() <= 200
      && data.city is string
      && data.city.size() > 0
      && data.city.size() <= 100
      && data.country is string
      && data.country.size() > 0
      && data.country.size() <= 100
      && data.pc is string
      && data.pc.size() > 0
      && data.pc.size() <= 20
      && data.x is number
      && data.x >= -90
      && data.x <= 90
      && data.y is number
      && data.y >= -180
      && data.y <= 180
      && data.mission is string
      && data.mission.size() > 0
      && data.mission.size() <= 1000
      && (!('review' in data) || isValidReview(data.review))
      && (!('website' in data) || (data.website is string && data.website.size() <= 300));
    }

    function isValidReview(review) {
      return review.keys().hasOnly(['rating', 'comment'])
        && review.rating is int
        && review.rating >= 1
        && review.rating <= 5
        && (!('comment' in review) || (review.comment is string && review.comment.size() <= 500));
    }

    // Contact soumis via une proposition en attente : pas encore publié, pas
    // encore de jeton de masquage (celui-ci n'est créé qu'à la publication,
    // juste avant l'envoi de l'email).
    function isValidPendingContactData(data) {
      return data.keys().hasOnly(['firstName', 'lastName', 'role', 'email', 'phone'])
        && data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 100
        && data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 100
        && data.role is string && data.role.size() > 0 && data.role.size() <= 150
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.phone is string && data.phone.size() <= 30;
    }

    // Contact d'une entreprise publiée : visible publiquement, et muni d'un
    // jeton permettant à la personne elle-même de masquer ses informations
    // sans être authentifiée (lien envoyé par email).
    function isValidPublishedContactData(data) {
      return data.keys().hasOnly(['firstName', 'lastName', 'role', 'email', 'phone', 'hidden', 'hideToken'])
        && data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 100
        && data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 100
        && data.role is string && data.role.size() > 0 && data.role.size() <= 150
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.phone is string && data.phone.size() <= 30
        && data.hidden is bool
        && data.hideToken is string && data.hideToken.size() >= 16;
    }

    // Un contact masqué par son propre titulaire : toutes les informations
    // personnelles sont effacées (pas seulement cachées côté affichage), le
    // jeton reste inchangé (il a servi à autoriser cette seule action).
    function isSelfRedactedContact(newData, oldData) {
      return newData.keys().hasOnly(['firstName', 'lastName', 'role', 'email', 'phone', 'hidden', 'hideToken'])
        && newData.firstName == ''
        && newData.lastName == ''
        && newData.role == ''
        && newData.email == ''
        && newData.phone == ''
        && newData.hidden == true
        && newData.hideToken == oldData.hideToken
        && oldData.hidden == false;
    }

    // Entreprises validées, visibles publiquement sur la carte. Elles ne
    // peuvent être créées que par un administrateur connecté : soit
    // directement, soit via la validation d'une proposition en attente.
    match /companies/{companyId} {
      allow read: if true;
      allow create: if request.auth != null && isValidCompanyData(request.resource.data);
      allow update, delete: if false;

      // Personnes à contacter pour cette entreprise (CV / lettre de
      // motivation). Lecture publique : c'est tout l'intérêt de la donnée.
      match /contacts/{contactId} {
        allow read: if true;
        allow create: if request.auth != null && isValidPublishedContactData(request.resource.data) && request.resource.data.hidden == false;
        allow delete: if false;
        allow update: if (request.auth != null && isValidPublishedContactData(request.resource.data))
          || isSelfRedactedContact(request.resource.data, resource.data);
      }
    }

    // Propositions d'ajout soumises par n'importe qui (y compris des
    // visiteurs non connectés), en attente de validation par un admin.
    // Seul un administrateur connecté peut les lire, les modifier ou les
    // supprimer (refus, ou nettoyage après validation).
    match /pendingCompanies/{pendingId} {
      allow read: if request.auth != null;
      allow create: if isValidCompanyData(request.resource.data);
      allow update: if request.auth != null && isValidCompanyData(request.resource.data);
      allow delete: if request.auth != null;

      match /contacts/{contactId} {
        allow read: if request.auth != null;
        allow create: if isValidPendingContactData(request.resource.data);
        allow update: if request.auth != null && isValidPendingContactData(request.resource.data);
        allow delete: if request.auth != null;
      }
    }

    function isValidTicketData(data) {
      return data.keys().hasOnly(['title', 'description', 'status', 'createdAt', 'pageUrl', 'userAgent'])
        && data.title is string
        && data.title.size() <= 150
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 2000
        && data.status in ['open', 'in_progress', 'closed']
        && data.createdAt is timestamp
        && data.pageUrl is string
        && data.pageUrl.size() <= 500
        && data.userAgent is string
        && data.userAgent.size() <= 300;
    }

    // Signalements de problème envoyés depuis le bouton d'info, par
    // n'importe qui (y compris des visiteurs non connectés). Seul un
    // administrateur connecté peut les consulter ; la création impose un
    // statut initial "open" et la modification ne peut faire évoluer que ce
    // statut (titre/description/date figés une fois le ticket créé).
    match /tickets/{ticketId} {
      allow read: if request.auth != null;
      allow create: if isValidTicketData(request.resource.data) && request.resource.data.status == 'open';
      allow update: if request.auth != null
        && isValidTicketData(request.resource.data)
        && request.resource.data.title == resource.data.title
        && request.resource.data.description == resource.data.description
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if request.auth != null;
    }
  }
}
