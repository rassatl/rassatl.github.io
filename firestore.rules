rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deux types de comptes Firebase Auth coexistent : les administrateurs
    // (email + mot de passe) et les étudiants, qui se connectent par lien
    // envoyé à leur email étudiant. Être authentifié ne suffit donc plus à
    // être admin : il faut avoir un document admins/{uid}, créé à la main
    // depuis la console Firebase (aucun client ne peut l'écrire).
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Étudiant dont l'email a été vérifié par le lien de connexion (l'email
    // d'un compte créé sans lien n'est jamais marqué comme vérifié). Le
    // domaine doit rester synchronisé avec src/utils/studentEmail.js.
    function isStudent() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.+@groupe-esigelec[.]org');
    }

    function companyKeys() {
      return [
        'speciality', 'name', 'address', 'city', 'country', 'pc', 'x', 'y', 'mission', 'review', 'website'
      ];
    }

    // Une entreprise publiée est lisible par tout le monde : elle n'embarque
    // l'email de l'étudiant qui l'a proposée (addedBy) que si celui-ci a
    // choisi de s'afficher. Dans tous les cas, l'auteur est conservé à part,
    // dans la collection privée companyAuthors.
    function isValidCompanyData(data) {
      return data.keys().hasOnly(companyKeys().concat(['addedBy']))
        && hasValidCompanyFields(data)
        && (!('addedBy' in data) || (data.addedBy is string && data.addedBy.size() > 0 && data.addedBy.size() <= 200));
    }

    // Une proposition en attente porte l'email étudiant vérifié de son auteur
    // (lisible uniquement par un admin, voir plus bas) et son choix de
    // s'afficher ou non une fois l'entreprise publiée.
    function isValidPendingCompanyData(data) {
      return data.keys().hasOnly(companyKeys().concat(['submittedBy', 'submitterVisible']))
        && hasValidCompanyFields(data)
        && (!('submittedBy' in data) || (data.submittedBy is string && data.submittedBy.size() <= 200))
        && (!('submitterVisible' in data) || data.submitterVisible is bool);
    }

    // Trace privée de l'auteur d'une entreprise publiée.
    function isValidCompanyAuthorData(data) {
      return data.keys().hasOnly(['submittedBy', 'visible', 'companyName', 'approvedAt'])
        && data.submittedBy is string && data.submittedBy.size() > 0 && data.submittedBy.size() <= 200
        && data.visible is bool
        && data.companyName is string && data.companyName.size() > 0 && data.companyName.size() <= 120
        && data.approvedAt is timestamp;
    }

    function hasValidCompanyFields(data) {
      return data.speciality in [
        'Développement Logiciel, Tests et Qualité', 'IA & Big Data'
      ]
      && data.name is string
      && data.name.size() > 0
      && data.name.size() <= 120
      && data.address is string
      && data.address.size() > 0
      && data.address.size() <= 200
      && data.city is string
      && data.city.size() > 0
      && data.city.size() <= 100
      && data.country is string
      && data.country.size() > 0
      && data.country.size() <= 100
      && data.pc is string
      && data.pc.size() > 0
      && data.pc.size() <= 20
      && data.x is number
      && data.x >= -90
      && data.x <= 90
      && data.y is number
      && data.y >= -180
      && data.y <= 180
      && data.mission is string
      && data.mission.size() > 0
      && data.mission.size() <= 1000
      && (!('review' in data) || isValidReview(data.review))
      && (!('website' in data) || (data.website is string && data.website.size() <= 300));
    }

    function isValidReview(review) {
      return review.keys().hasOnly(['rating', 'comment'])
        && review.rating is int
        && review.rating >= 1
        && review.rating <= 5
        && (!('comment' in review) || (review.comment is string && review.comment.size() <= 500));
    }

    // Contact soumis via une proposition en attente : pas encore publié, pas
    // encore de jeton de masquage (celui-ci n'est créé qu'à la publication,
    // juste avant l'envoi de l'email).
    function isValidPendingContactData(data) {
      return data.keys().hasOnly(['firstName', 'lastName', 'role', 'email', 'phone'])
        && data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 100
        && data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 100
        && data.role is string && data.role.size() > 0 && data.role.size() <= 150
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.phone is string && data.phone.size() <= 30;
    }

    // Contact d'une entreprise publiée : visible publiquement, et muni d'un
    // jeton permettant à la personne elle-même de masquer ses informations
    // sans être authentifiée (lien envoyé par email).
    function isValidPublishedContactData(data) {
      return data.keys().hasOnly(['firstName', 'lastName', 'role', 'email', 'phone', 'hidden', 'hideToken'])
        && data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 100
        && data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 100
        && data.role is string && data.role.size() > 0 && data.role.size() <= 150
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.phone is string && data.phone.size() <= 30
        && data.hidden is bool
        && data.hideToken is string && data.hideToken.size() >= 16;
    }

    // Un contact masqué par son propre titulaire : toutes les informations
    // personnelles sont effacées (pas seulement cachées côté affichage), le
    // jeton reste inchangé (il a servi à autoriser cette seule action).
    function isSelfRedactedContact(newData, oldData) {
      return newData.keys().hasOnly(['firstName', 'lastName', 'role', 'email', 'phone', 'hidden', 'hideToken'])
        && newData.firstName == ''
        && newData.lastName == ''
        && newData.role == ''
        && newData.email == ''
        && newData.phone == ''
        && newData.hidden == true
        && newData.hideToken == oldData.hideToken
        && oldData.hidden == false;
    }

    // Comptes administrateurs : le document admins/{uid} est créé à la main
    // depuis la console Firebase. Un utilisateur peut seulement vérifier s'il
    // a le sien (c'est ainsi que l'app sait afficher les actions admin) ;
    // personne ne peut lister ni écrire, sinon un étudiant pourrait se
    // promouvoir lui-même.
    match /admins/{adminUid} {
      allow get: if request.auth != null && request.auth.uid == adminUid;
      allow list, write: if false;
    }

    // Qui a ajouté chaque entreprise publiée (email étudiant vérifié, et s'il
    // a choisi de s'afficher publiquement), indexé par l'identifiant de
    // l'entreprise. Collection privée : réservée aux admins, en lecture comme
    // en écriture, et conservée même quand la proposition en attente est
    // supprimée à la validation.
    match /companyAuthors/{companyId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidCompanyAuthorData(request.resource.data);
      allow update, delete: if false;
    }

    // Entreprises validées, visibles publiquement sur la carte. Elles ne
    // peuvent être créées que par un administrateur connecté : soit
    // directement, soit via la validation d'une proposition en attente.
    match /companies/{companyId} {
      allow read: if true;
      allow create: if isAdmin() && isValidCompanyData(request.resource.data);
      allow update, delete: if false;

      // Personnes à contacter pour cette entreprise (CV / lettre de
      // motivation). Seuls les étudiants vérifiés (et les admins) peuvent les
      // lister : un visiteur ne peut donc pas récupérer les coordonnées.
      // La lecture d'un contact précis, par son identifiant, reste ouverte :
      // le lien « masquer mes informations » envoyé à la personne concernée
      // doit fonctionner sans connexion. Cet identifiant, aléatoire, n'est
      // connu que de la personne (dans son lien) et de ceux qui ont accès à
      // la liste.
      match /contacts/{contactId} {
        allow get: if true;
        allow list: if isStudent() || isAdmin();
        allow create: if isAdmin() && isValidPublishedContactData(request.resource.data) && request.resource.data.hidden == false;
        allow delete: if false;
        allow update: if (isAdmin() && isValidPublishedContactData(request.resource.data))
          || isSelfRedactedContact(request.resource.data, resource.data);
      }
    }

    // Propositions d'ajout soumises par des étudiants dont l'email a été
    // vérifié, en attente de validation par un admin. La proposition doit
    // porter l'email vérifié de son auteur (pas d'usurpation possible). Seul
    // un administrateur connecté peut les lire, les modifier ou les
    // supprimer (refus, ou nettoyage après validation).
    match /pendingCompanies/{pendingId} {
      allow read: if isAdmin();
      allow create: if isStudent()
        && isValidPendingCompanyData(request.resource.data)
        && request.resource.data.submittedBy == request.auth.token.email
        && request.resource.data.submitterVisible is bool;
      allow update: if isAdmin() && isValidPendingCompanyData(request.resource.data);
      allow delete: if isAdmin();

      // Un contact ne peut être ajouté que par l'auteur de la proposition.
      match /contacts/{contactId} {
        allow read: if isAdmin();
        allow create: if isStudent()
          && isValidPendingContactData(request.resource.data)
          && get(/databases/$(database)/documents/pendingCompanies/$(pendingId)).data.submittedBy == request.auth.token.email;
        allow update: if isAdmin() && isValidPendingContactData(request.resource.data);
        allow delete: if isAdmin();
      }
    }

    function isValidTicketData(data) {
      return data.keys().hasOnly(['title', 'description', 'status', 'createdAt', 'pageUrl', 'userAgent'])
        && data.title is string
        && data.title.size() <= 150
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 2000
        && data.status in ['open', 'in_progress', 'closed']
        && data.createdAt is timestamp
        && data.pageUrl is string
        && data.pageUrl.size() <= 500
        && data.userAgent is string
        && data.userAgent.size() <= 300;
    }

    // Signalements de problème envoyés depuis le bouton d'info, par
    // n'importe qui (y compris des visiteurs non connectés). Seul un
    // administrateur connecté peut les consulter ; la création impose un
    // statut initial "open" et la modification ne peut faire évoluer que ce
    // statut (titre/description/date figés une fois le ticket créé).
    match /tickets/{ticketId} {
      allow read: if isAdmin();
      allow create: if isValidTicketData(request.resource.data) && request.resource.data.status == 'open';
      allow update: if isAdmin()
        && isValidTicketData(request.resource.data)
        && request.resource.data.title == resource.data.title
        && request.resource.data.description == resource.data.description
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    function isValidErrorLogData(data) {
      return data.keys().hasOnly(['message', 'code', 'stack', 'context', 'createdAt', 'pageUrl', 'userAgent'])
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 500
        && (!('code' in data) || (data.code is string && data.code.size() <= 100))
        && data.stack is string
        && data.stack.size() <= 3000
        && data.context is string
        && data.context.size() <= 200
        && data.createdAt is timestamp
        && data.pageUrl is string
        && data.pageUrl.size() <= 500
        && data.userAgent is string
        && data.userAgent.size() <= 300;
    }

    // Erreurs techniques rencontrées par n'importe quel visiteur, journalées
    // automatiquement (pas de saisie utilisateur) pour pouvoir diagnostiquer
    // un problème en prod sans dépendre de la console de son navigateur.
    // Mêmes règles d'accès que les tickets : écriture publique, lecture et
    // suppression réservées à un administrateur connecté.
    match /errorLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isValidErrorLogData(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
