# Chargé automatiquement par Vite en mode "e2e" (voir playwright.config.js),
# en plus de ".env" mais avec priorité dessus. Aucune valeur ici n'est un
# vrai secret : elles pointent l'app vers les émulateurs Firebase locaux.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_PROJECT_ID=demo-find-my-company
VITE_USE_FIREBASE_EMULATOR=true

# Volontairement vides : EmailJS n'est pas appelé pendant les tests (voir
# useEmailNotifications.js, qui log un warning et ne fait rien sans ces
# variables), pour ne pas envoyer de vrais emails pendant l'exécution des
# tests E2E.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
